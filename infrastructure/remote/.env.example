# Modo remoto: el servidor queda accesible solo dentro de la red Docker
# "meka-network". Exponerlo a internet es responsabilidad tuya: un proxy
# inverso (Nginx, Caddy...) o un túnel (Cloudflare Tunnel, Tailscale...) unido
# a esa misma red. Ver infrastructure/README.md para el contrato que ese
# proxy/túnel debe cumplir.

# Used in the container name.
PROJECT_NAME=meka-filesystem

# Ownership for files created on the mounted host volume.
MEKA_UID=1000
MEKA_GID=1000

# Absolute host path that the MCP server may manage.
MEKA_WORKSPACE_PATH=/srv/meka/workspace

# Authentication mode: none, api-key (default), or oidc.
# Never use "none" here: this compose file is meant to be reachable from
# outside the host through your own proxy/tunnel.
MEKA_AUTH_MODE=api-key

# Required only when MEKA_AUTH_MODE=api-key. Generate with ../generate-api-key.sh.
# Do not commit a real key.
MEKA_API_KEY=replace-with-a-generated-secret

# Required only when MEKA_AUTH_MODE=oidc. The resource URL is the public MCP
# endpoint, for example https://archivo.example.com/mcp.
MEKA_OIDC_ISSUER=
MEKA_OIDC_AUDIENCE=
MEKA_OIDC_JWKS_URL=
MEKA_OIDC_RESOURCE_URL=
