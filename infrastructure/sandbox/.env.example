# Modo jaula: aislación local completa. Sin red externa, sin proxy, sin
# túnel. Todo lo que hace falta es este archivo + generate-api-key.sh.
#
# El servidor solo puede tocar la carpeta que le montes en
# MEKA_WORKSPACE_PATH; el resto de tu disco no es alcanzable, ni siquiera
# si el agente conectado se equivoca o intenta escapar con "..".

# Used in the container name.
PROJECT_NAME=meka-filesystem-sandbox

# Ownership for files created on the mounted host volume.
MEKA_UID=1000
MEKA_GID=1000

# Absolute host path to isolate. Only this folder is reachable through the
# server — nothing else on the host.
MEKA_WORKSPACE_PATH=/home/tu-usuario/carpeta-de-pruebas

# Local-only port. Bound to 127.0.0.1 by the compose file itself: it is
# never exposed beyond this machine, regardless of firewall configuration.
MEKA_PORT=8787

# Authentication: "api-key" (recommended default, some protection even on
# localhost if other processes or users share this machine) or "none"
# (only if you fully trust everything running on this machine). "oidc"
# is not supported here — it requires a public resource URL, which
# contradicts the whole point of this mode.
MEKA_AUTH_MODE=api-key

# Required when MEKA_AUTH_MODE=api-key. Generate with ../generate-api-key.sh.
# Do not commit a real key.
MEKA_API_KEY=replace-with-a-generated-secret
